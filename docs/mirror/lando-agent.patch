+else:
+    print(\"COST_LINE='partial — see issue comments'\")
+tok = t['tokens']; total = sum(tok.values())
+def h(n): return f'{n/1e6:.1f}M' if n >= 1e6 else f'{n//1000}k'
+per = {}
+for s in row['stages']:
